// Discover all containers on the local Docker daemon.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Collect logs from every discovered container.
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.process.helix_json.receiver]

  refresh_interval = "5s"
}

// Parse JSON log lines and promote helix fields as Loki stream labels.
loki.process "helix_json" {
  // Try to parse each line as JSON; non-JSON lines pass through unchanged.
  stage.json {
    expressions = {
      helix_instrument_id = "helix_instrument_id",
      helix_process_name  = "helix_process_name",
      level               = "level",
      helix_entity_id     = "helix_entity_id",
      otel_trace_id       = "otel_trace_id",
    }
  }

  // Low-cardinality fields as stream labels — safe to index.
  // helix_entity_id is intentionally NOT a stream label — one stream per entity
  // would exhaust Loki's stream limit. It is promoted as structured metadata instead.
  stage.labels {
    values = {
      helix_instrument_id = "",
      helix_process_name  = "",
      level               = "",
    }
  }

  // Promote entity ID and trace ID as structured metadata so the HelixObs
  // Grafana dashboards can filter with | helix_entity_id = `...` and
  // | trace_id = `...` — the same queries that work for OTLP-delivered logs.
  stage.structured_metadata {
    values = {
      helix_entity_id = "",
      trace_id        = "otel_trace_id",
    }
  }

  forward_to = [loki.write.default.receiver, loki.write.remote.receiver]
}

// Write to the Loki instance in the same compose network.
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Optional remote Loki forwarding.
// Set REMOTE_LOKI_URL in the environment to forward logs to an additional Loki instance.
// REMOTE_LOKI_URL defaults to the local Loki when unset — Loki rejects exact duplicates
// with 400 and does not store them twice, so the no-op case is harmless.
loki.write "remote" {
  endpoint {
    url       = env("REMOTE_LOKI_URL")
    tenant_id = env("REMOTE_LOKI_TENANT_ID")
  }
}
