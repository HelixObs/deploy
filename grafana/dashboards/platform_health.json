{
  "__inputs": [],
  "__requires": [],
  "description": "HelixObs platform health \u2014 host, herald, and backend services.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Host",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "title": "CPU Utilisation",
      "type": "gauge",
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ],
      "description": "Percentage of CPU time not spent idle (1 \u2212 idle / total). Warning: > 80% sustained for 10 min. Critical: > 95% for 5 min."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "title": "Memory Utilisation",
      "type": "gauge",
      "targets": [
        {
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "memory",
          "refId": "A"
        }
      ],
      "description": "Fraction of host RAM in use (1 \u2212 MemAvailable / MemTotal). Warning: > 85%. Critical: > 95%."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "title": "Disk Utilisation",
      "type": "gauge",
      "targets": [
        {
          "expr": "1 - min(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|rootfs\"}) / min(node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|rootfs\"})",
          "legendFormat": "disk",
          "refId": "A"
        }
      ],
      "description": "Fraction of filesystem capacity consumed. Warning: < 20% free. Critical: < 10% free."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "title": "Network I/O",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total[5m])",
          "legendFormat": "rx {{device}}",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total[5m])",
          "legendFormat": "tx {{device}}",
          "refId": "B"
        }
      ],
      "description": "Bytes received and transmitted per second across all network interfaces."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 10,
      "title": "Herald",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "id": 11,
      "title": "Entity Ingestion Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(helix_entities_total[1m])) by (instrument_id)",
          "legendFormat": "{{instrument_id}}",
          "refId": "A"
        },
        {
          "expr": "rate(helix_spans_passthrough_total[1m])",
          "legendFormat": "passthrough",
          "refId": "B"
        }
      ],
      "description": "Entity spans processed per second, by instrument and status. A sustained drop to zero indicates the pipeline may be stalled."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "id": 12,
      "title": "Span Processing Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(helix_span_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(helix_span_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(helix_span_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "description": "End-to-end herald processing time per helix span \u2014 from receipt to forwarding. Covers TraceStore lookup, DB write scheduling, and span mutation. Alert: p99 > 100 ms."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "id": 13,
      "title": "Parent Resolution Success Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(helix_parent_resolution_total{result=\"success\"}[5m]) / rate(helix_parent_resolution_total[5m])",
          "legendFormat": "{{instrument_id}}",
          "refId": "A"
        }
      ],
      "description": "Fraction of helix.parent.ids lookups that resolved to a known span in the TraceStore. Misses are expected when a child arrives before its parent; the attribute is preserved for server-side recovery. Alert: failure rate > 1%."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "id": 14,
      "title": "DB Write Success Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(helix_db_writes_total{status=\"success\"}[5m]) / rate(helix_db_writes_total[5m])",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "description": "Fraction of TimescaleDB writes that succeeded, by table. Failures are logged and metered but never block span forwarding. Alert: failure rate > 0.1%."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "id": 15,
      "title": "Herald RSS Memory",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"herald\"}",
          "legendFormat": "rss",
          "refId": "A"
        }
      ],
      "description": "Resident set size of the herald process in bytes. Sustained growth beyond baseline may indicate a TraceStore leak or goroutine accumulation. Alert: > 1.5 GB."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 14
      },
      "id": 16,
      "title": "Trace Store Size",
      "type": "timeseries",
      "targets": [
        {
          "expr": "helix_trace_store_size",
          "legendFormat": "entries",
          "refId": "A"
        }
      ],
      "description": "Number of entity_id \u2192 SpanRef entries currently held in the in-process TraceStore. When the store is full the oldest entry is evicted (FIFO). Configured maximum: 500 k entries."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 14
      },
      "id": 17,
      "title": "DB Connection Pool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "helix_db_connections_in_use",
          "legendFormat": "in use",
          "refId": "A"
        },
        {
          "expr": "helix_db_connections_total",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "description": "pgxpool connections currently acquired vs total pool size. High utilisation means write goroutines are queuing behind the pool. Alert: > 80% utilised."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 14
      },
      "id": 18,
      "title": "Error Rate by Instrument",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(helix_errors_total[5m])",
          "legendFormat": "{{instrument_id}}",
          "refId": "A"
        }
      ],
      "description": "Rate of helix.error span events per second, by instrument. These are domain errors (e.g. RFI contamination, classifier failure), not herald errors. Alert: > 5% of entity rate for 5 min."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 25,
      "title": "Parent Resolution Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(helix_parent_resolution_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(helix_parent_resolution_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(helix_parent_resolution_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "description": "Time to resolve one parent entity ID to a span link, from lookup start through link construction. Measures the hot path through the TraceStore mutex. Sub-millisecond is normal; spikes indicate lock contention."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 26,
      "title": "Trace Store Lookup Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(helix_trace_store_lookup_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(helix_trace_store_lookup_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "description": "Time for a single TraceStore Get() call, including mutex acquisition. Expected baseline: < 10 \u00b5s. Elevated values indicate lock contention from high concurrent span throughput."
    },
    {
      "id": 27,
      "title": "API Request Rate",
      "description": "HTTP API requests per second by handler and outcome status.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (handler, status) (rate(helix_api_requests_total[1m]))",
          "legendFormat": "{{handler}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 28,
      "title": "API Request Latency",
      "description": "End-to-end HTTP handler latency percentiles (p50 / p95 / p99).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(helix_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{handler}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(helix_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{handler}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(helix_api_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{handler}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 29,
      "title": "DB Query Rate & Success",
      "description": "TimescaleDB read query rate and success rate by query name.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
