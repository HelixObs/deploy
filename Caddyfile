{
    admin localhost:2019
}

# HTTPS: HelixObs UI + herald auth endpoint
# Caddy automatically redirects http:// to https:// and handles Let's Encrypt via TLS-ALPN-01.
{$HELIXOBS_DOMAIN} {
    # Auth token exchange — instrument pipelines call this to get a HelixObs JWT.
    handle /auth/token {
        reverse_proxy herald:8080
    }
    # Everything else → UI
    handle {
        reverse_proxy ui:3000
    }
}

# HTTPS: Grafana dashboards
{$HELIXOBS_DOMAIN}:3001 {
    reverse_proxy grafana:3000
}

