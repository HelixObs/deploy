        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 20,
      "title": "Backends",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 40
      },
      "id": 21,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "title": "Herald",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"herald\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Herald process uptime derived from process_start_time_seconds. Resets on container restart."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 3,
        "y": 40
      },
      "id": 22,
      "title": "OTel Collector \u2014 Spans",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(otelcol_receiver_accepted_spans_total[1m])",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "expr": "rate(otelcol_receiver_refused_spans_total[1m])",
          "legendFormat": "refused",
          "refId": "B"
        },
        {
          "expr": "rate(otelcol_exporter_sent_spans_total[1m])",
          "legendFormat": "exported",
          "refId": "C"
        }
      ],
      "description": "Spans accepted from the herald vs successfully exported to Tempo. A gap between the two indicates export failures. refused_spans > 0 signals backpressure \u2014 the collector is falling behind."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 10,
        "y": 40
      },
      "id": 23,
      "title": "Loki Ingestion Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(loki_distributor_lines_received_total[5m]))",
          "legendFormat": "lines/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loki_distributor_bytes_received_total[5m]))",
          "legendFormat": "bytes/s",
          "refId": "B"
        }
      ],
      "description": "Log lines per second arriving at the Loki distributor. A drop to zero means the Alloy sidecar log shipper has stalled."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 7,
        "x": 17,
        "y": 40
      },
      "id": 24,
      "title": "Tempo Trace Ingestion",
      "type": "timeseries",
