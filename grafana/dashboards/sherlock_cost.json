        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 15,
      "title": "Recent Investigations (cost ledger)",
      "type": "table",
      "options": {
        "sortBy": [
          {
            "displayName": "created_at",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT created_at, session_id, instrument_id, entity_id, model, tokens_input + tokens_output AS total_tokens, ROUND(cost_usd::numeric, 4) AS cost_usd, duration_ms, tool_calls, successful FROM sherlock_usage ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "refId": "A"
        }
      ]
    },
