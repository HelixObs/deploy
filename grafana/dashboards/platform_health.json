      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(otelcol_receiver_accepted_spans_total[1m])",
          "legendFormat": "accepted",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(otelcol_receiver_refused_spans_total[1m])",
          "legendFormat": "refused",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(otelcol_exporter_sent_spans_total[1m])",
          "legendFormat": "exported",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Spans accepted from the herald vs successfully exported to Tempo. A gap between the two indicates export failures. refused_spans > 0 signals backpressure \u2014 the collector is falling behind."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
