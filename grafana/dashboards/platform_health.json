        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (query, status) (rate(helix_db_queries_total[1m]))",
          "legendFormat": "{{query}} / {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "title": "DB Query Latency",
      "description": "TimescaleDB read latency percentiles (p50 / p95 / p99) by query name.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, query) (rate(helix_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{query}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, query) (rate(helix_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{query}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, query) (rate(helix_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{query}}",
