    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Provenance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "Ancestor graph built from parent_ids. Nodes = entities, edges = parent\u2192child links.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Inspect this entity",
                    "url": "/d/helix-entity-inspector?var-entity_id=${__data.fields.id}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "arc__current"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byName",
              "options": "arc__other"
            },
            "properties": []
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "edges": {},
        "layoutAlgorithm": "layered",
        "nodes": {},
        "zoomMode": "cooperative"
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH RECURSIVE\nancestors AS (\n  SELECT id, parent_ids, instrument_id, to_timestamp(timestamp_ns / 1e9) AS ts\n  FROM entities WHERE id = '$entity_id'\n  UNION ALL\n  SELECT e.id, e.parent_ids, e.instrument_id, to_timestamp(e.timestamp_ns / 1e9)\n  FROM entities e JOIN ancestors a ON e.id = ANY(a.parent_ids)\n),\ndescendants AS (\n  SELECT id, parent_ids, instrument_id, to_timestamp(timestamp_ns / 1e9) AS ts\n  FROM entities WHERE id = '$entity_id'\n  UNION ALL\n  SELECT e.id, e.parent_ids, e.instrument_id, to_timestamp(e.timestamp_ns / 1e9)\n  FROM entities e JOIN descendants d ON d.id = ANY(e.parent_ids)\n),\nfull_dag AS (\n  SELECT * FROM ancestors UNION SELECT * FROM descendants\n)\nSELECT\n  id                                                              AS \"id\",\n  CASE WHEN id = '$entity_id' THEN id || ' \u25c4' ELSE id END       AS \"title\",\n  instrument_id                                                   AS \"mainStat\",\n  ts                                                              AS \"detail__time\",\n  CASE WHEN id = '$entity_id' THEN 1.0 ELSE 0.0 END::float8     AS \"arc__current\",\n  CASE WHEN id = '$entity_id' THEN 0.0 ELSE 1.0 END::float8     AS \"arc__other\"\nFROM full_dag",
          "refId": "nodes"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH RECURSIVE\nancestors AS (\n  SELECT id, parent_ids FROM entities WHERE id = '$entity_id'\n  UNION ALL\n  SELECT e.id, e.parent_ids FROM entities e JOIN ancestors a ON e.id = ANY(a.parent_ids)\n),\ndescendants AS (\n  SELECT id, parent_ids FROM entities WHERE id = '$entity_id'\n  UNION ALL\n  SELECT e.id, e.parent_ids FROM entities e JOIN descendants d ON d.id = ANY(e.parent_ids)\n),\nfull_dag AS (\n  SELECT * FROM ancestors UNION SELECT * FROM descendants\n)\nSELECT DISTINCT\n  p.pid || ':' || f.id AS \"id\",\n  p.pid                AS \"source\",\n  f.id                 AS \"target\"\nFROM full_dag f\nCROSS JOIN LATERAL unnest(f.parent_ids) AS p(pid)\nWHERE p.pid IN (SELECT id FROM full_dag)\n  AND array_length(f.parent_ids, 1) > 0",
          "refId": "edges"
        }
      ],
      "title": "Provenance DAG",
      "type": "nodeGraph"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "Trace IDs for every entity in the provenance DAG. Click a trace_id to open it in Tempo.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "View in span tree",
                    "url": "/d/helix-entity-inspector?var-entity_id=${entity_id}&var-active_trace_id=${__data.fields.trace_id}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "time"
          }
        ]
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  'creation'  AS \"operation\",\n  trace_id,\n  to_timestamp(timestamp_ns / 1e9) AS \"time\"\nFROM entities\nWHERE id = '$entity_id' AND trace_id IS NOT NULL\nUNION ALL\nSELECT\n  operation   AS \"operation\",\n  trace_id,\n  to_timestamp(timestamp_ns / 1e9) AS \"time\"\nFROM entity_operations\nWHERE entity_id = '$entity_id' AND trace_id IS NOT NULL\nORDER BY \"time\" ASC",
          "refId": "A"
        }
      ],
      "title": "Trace",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "description": "All helix.* events recorded for this entity.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "time"
          }
        ]
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_timestamp(timestamp_ns / 1e9) AS \"time\",\n  event_name,\n  metadata\nFROM entity_events\nWHERE entity_id = '$entity_id'\nORDER BY timestamp_ns ASC",
          "refId": "A"
        }
      ],
      "title": "Entity Events",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Logs tagged with this entity's ID.",
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "unwrappedColumns": false,
        "wrapLogMessage": true
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{helix_instrument_id=~\".+\"} | json | otel_trace_id = `$active_trace_id` | line_format `{{.level | upper}} {{.msg}}`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "OTel trace for this entity's span.",
      "gridPos": {
        "h": 23,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 7,
      "options": {
        "query": "$active_trace_id",
        "spanFilters": {
          "adhocFilters": [],
          "criticalPathOnly": false,
          "matchesOnly": false
        }
      },
      "pluginVersion": "12.4.2",
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 20,
          "metricsQueryType": "range",
          "query": "$active_trace_id",
          "queryType": "traceql",
          "refId": "A",
          "serviceMapUseNativeHistograms": false,
          "tableType": "traces"
        }
      ],
      "title": "Span Tree",
      "type": "traces"
    }
  ],
