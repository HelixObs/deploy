      "id": 45,
      "title": "Canary & Auto-Discovered Service Presence (traces vs logs)",
      "type": "state-timeline",
      "targets": [
        {
          "expr": "helix_platform_check_presence",
          "legendFormat": "{{signal_source}} / {{signal_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Presence over time for the canary and every real service auto-discovered from recent Loki/Tempo activity (union of both — a service is checked if it shows up on either side, so a service that's gone silent on exactly one side stays visible via the other), split by traces vs logs. This is the same shape of visualization as the Pipeline Process Logs dashboard's Log Volume panel that first surfaced the 2026-08-28 incident — but side by side with traces, so a traces-present/logs-absent split (a pipeline bug) is visually distinct from both going quiet together (the instrument itself being offline). The 'canary / logs_by_label' row specifically is the one that would have caught that incident directly."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 62
      },
      "id": 46,
      "title": "Auto-Discovered Service Raw Result Counts",
      "type": "timeseries",
      "targets": [
