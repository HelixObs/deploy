      "type": "stat",
      "targets": [
        {
          "expr": "helix_platform_check_presence{signal_source=\"canary\", signal_type=\"logs_by_label\"}",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
