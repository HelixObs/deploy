{
  "__inputs": [],
  "__requires": [],
  "description": "Sherlock AI investigation cost tracking \u2014 token usage, latency, and tool breakdown.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "title": "Total Cost (all time)",
      "type": "stat",
      "targets": [
        {
          "expr": "sherlock_cost_usd_total",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Cumulative USD spent on Anthropic API calls since process start. Resets on restart \u2014 use the Recent Investigations table for durable financial records."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "title": "Total Queries",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(sherlock_queries_total)",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Total investigations completed (success + failed) since process start."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "title": "Query Success Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(sherlock_queries_total{status=\"success\"}[1h])) / sum(rate(sherlock_queries_total[1h]))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Fraction of investigations that produced a hypothesis (submit_hypothesis called) vs those that hit the turn cap or errored. Alert: < 95%."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "title": "Avg Query Duration",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(sherlock_query_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Median (p50) investigation duration from first Claude API call to completion. Dominated by streaming time and the number of tool calls."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "id": 5,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "title": "Total Tokens (input)",
      "type": "stat",
      "targets": [
        {
          "expr": "sherlock_tokens_input_total",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Cumulative input tokens sent to the Claude API. Input tokens include the system prompt, instrument context, conversation history, and tool results \u2014 they grow with every turn."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "id": 6,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "title": "Total Tokens (output)",
      "type": "stat",
      "targets": [
        {
          "expr": "sherlock_tokens_output_total",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Cumulative output tokens generated by Claude, including reasoning text and tool call JSON."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 10,
      "title": "Cumulative Cost Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sherlock_cost_usd_total",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Running total of USD cost by model. Use this to spot unexpected usage spikes or week-on-week cost growth."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 11,
      "title": "Query Latency (p50 / p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(sherlock_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (all)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sherlock_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 (all)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sherlock_query_duration_seconds_bucket[5m])) by (le, query_type))",
          "legendFormat": "p95 {{query_type}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Investigation latency by percentile, overall and broken down by query type. p95 > 30 s indicates user experience is degrading. Latency is dominated by Claude API streaming time and the number of tool calls."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "id": 12,
      "title": "Tool Calls per Second by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(sherlock_tool_calls_total{status=\"success\"}[5m])",
          "legendFormat": "{{tool_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Rate of tool calls by tool name. High rates on get_logs or search_logs may indicate Claude is looping or over-fetching. get_entity_provenance is expected to be the most frequent call."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "id": 13,
      "title": "Tool Call Latency p95 by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sherlock_tool_call_duration_seconds_bucket[5m])) by (le, tool_name))",
          "legendFormat": "{{tool_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "95th-percentile tool call latency by tool. get_logs and search_logs are the slowest (Loki queries). get_entity and get_entity_events should complete in under 50 ms. Spikes indicate upstream service issues."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 14,
      "title": "Tool Success Rate by Tool",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(sherlock_tool_calls_total{status=\"success\"}[5m]) / rate(sherlock_tool_calls_total[5m])",
          "legendFormat": "{{tool_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Fraction of successful tool calls by tool name. Failures are caught and returned as error JSON to Claude so it can adapt. Persistent failures on fetch_github_* tools usually indicate rate limiting."
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 15,
      "title": "Recent Investigations (cost ledger)",
      "type": "table",
      "options": {
        "sortBy": [
          {
            "displayName": "created_at",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT created_at, session_id, instrument_id, entity_id, model, tokens_input + tokens_output AS total_tokens, ROUND(cost_usd::numeric, 4) AS cost_usd, duration_ms, tool_calls, reached_hypothesis FROM sherlock_usage ORDER BY created_at DESC LIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          }
        }
      ],
      "description": "Durable cost ledger from TimescaleDB \u2014 one row per investigation with session, entity, model, tokens, cost, duration, and tool calls. Unlike Prometheus counters, this survives process restarts."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 16,
      "title": "Token Usage Over Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(sherlock_tokens_total[5m])",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Rate of combined (input + output) token consumption by model. Useful for spotting usage spikes and correlating token burn with investigation load."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 17,
      "title": "Cost per Query Distribution (p50 / p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(sherlock_cost_per_query_usd_bucket[1h]))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, rate(sherlock_cost_per_query_usd_bucket[1h]))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "description": "Distribution of per-investigation cost at p50 and p95. p95 > $0.10 may indicate investigations are consuming excessive context. Alert: single query > $1."
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "helixobs",
    "sherlock",
    "cost"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Sherlock Cost",
  "uid": "helix-sherlock-cost",
  "version": 1
}