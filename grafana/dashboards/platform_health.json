      ],
      "description": "Whether the synthetic canary log sent this tick was found in Loki at all, via the stable service_name label. This only proves ingestion is alive — it does NOT prove the log is queryable the way a real dashboard queries it. During the actual 2026-08-28 incident this stayed PRESENT the entire time; see 'Canary — Logs (dashboard-queryable)' for the panel that would have actually caught it."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
